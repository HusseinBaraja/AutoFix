<Window x:Class="AutoFix.SettingsUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AutoFix.SettingsUi.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Autofix Settings"
        Icon="{DynamicResource AutoFixLogoImage}"
        Width="1080"
        Height="720"
        MinWidth="920"
        MinHeight="620"
        Background="#F6F7FB"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed"
        Deactivated="Window_Deactivated">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="FocusSearch_Executed" CanExecute="FocusSearch_CanExecute" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.Find" Key="F" Modifiers="Control" />
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/SettingsTheme.xaml" />
                <ResourceDictionary Source="Resources/SettingsChrome.xaml" />
                <ResourceDictionary Source="Resources/SettingsControls.xaml" />
                <ResourceDictionary Source="Resources/SettingsTables.xaml" />
                <ResourceDictionary Source="Resources/HotkeyRecorder.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="20,12,20,10" IsEnabled="{Binding CanEditSettings}">
            <DockPanel>
                <Button Content="Clear search" Command="{Binding ClearSearchCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"
                        Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVisibility}}" />
                <Border Style="{StaticResource InputShell}">
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search settings" Height="40" />
                        <TextBlock Text="Search settings — try word threshold, timeout, or queue behavior" Margin="13,0"
                                   Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchQuery}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DockPanel>
            <TextBlock Text="{Binding SearchSummary}" Margin="2,6,0,0" Foreground="{StaticResource MutedTextBrush}"
                       AutomationProperties.Name="Settings search results" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Border Grid.Row="1" Background="#FFFFFF"
                IsEnabled="{Binding CanEditSettings}"
                BorderBrush="#E5E8F0"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,16">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{DynamicResource AutoFixLogoImage}"
                               Width="30"
                               Height="30"
                               Margin="0,0,10,0" />
                        <TextBlock Text="AutoFix"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <ListBox ItemsSource="{Binding SectionView}"
                         SelectedItem="{Binding SelectedSection}"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         AutomationProperties.Name="Settings sections"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:HighlightTextBlock HighlightText="{Binding Name}"
                                       Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Grid.Row="1" Margin="28" IsEnabled="{Binding CanEditSettings}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="True" Visibility="{Binding HasSelectedSection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <controls:HighlightTextBlock HighlightText="{Binding SelectedSection.Name}"
                                                     Query="{Binding SearchText}"
                                                     FontSize="28"
                                                     FontWeight="SemiBold" />
                        <TextBlock Text="Unsaved changes"
                                   Margin="14,7,0,0"
                                   Foreground="#667085"
                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <controls:HighlightTextBlock HighlightText="{Binding SelectedSection.Description}"
                                                 Query="{Binding SearchText}"
                                                 Margin="0,5,0,0"
                                                 Foreground="#667085" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer x:Name="SettingsScrollViewer"
                          Visibility="{Binding HasSelectedSection, Converter={StaticResource BoolToVisibility}}"
                          Grid.Row="2"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Width="{Binding ViewportWidth, ElementName=SettingsScrollViewer}">
                    <ItemsControl ItemsSource="{Binding SelectedSection.Settings}"
                                  Width="{Binding ViewportWidth, ElementName=SettingsScrollViewer}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Visibility" Value="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibility}}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <DockPanel LastChildFill="True"
                                                   Visibility="{Binding IsBackgroundStatus, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal"
                                                        DockPanel.Dock="Right"
                                                        HorizontalAlignment="Right">
                                                <Button Content="Launch later"
                                                        Command="{Binding DataContext.LaunchBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Margin="0,0,8,0" />
                                                <Button Content="Refresh"
                                                        Command="{Binding DataContext.RefreshStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="{Binding DataContext.StatusTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DataContext.StatusDetail, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Margin="0,4,0,0"
                                                           Foreground="#667085" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Grid Visibility="{Binding IsRegularSetting, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="320" />
                                            </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <controls:HighlightTextBlock HighlightText="{Binding Title}"
                                                                                 Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 FontWeight="SemiBold"
                                                                                 FontSize="15" />
                                                    <controls:HighlightTextBlock Style="{StaticResource BodyText}"
                                                                                 HighlightText="{Binding Description}"
                                                                                 Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Margin="0,4,0,0"
                                                                                 TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ValidationError}"
                                                               Margin="0,6,0,0"
                                                               Foreground="#B42318"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                                          HorizontalAlignment="Right"
                                                          IsChecked="{Binding IsEnabled}"
                                                          IsEnabled="{Binding IsAvailable}"
                                                          AutomationProperties.Name="{Binding Title}"
                                                          Visibility="{Binding IsToggle, Converter={StaticResource BoolToVisibility}}" />
                                                <ComboBox Width="320"
                                                          SelectionChanged="ApiProvider_SelectionChanged"
                                                          ItemsSource="{Binding Options}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding SelectedValue}"
                                                          IsEnabled="{Binding IsAvailable}"
                                                          AutomationProperties.Name="{Binding Title}"
                                                          Visibility="{Binding IsDropdown, Converter={StaticResource BoolToVisibility}}" />
                                                <Border Style="{StaticResource InputShell}"
                                                        Width="320"
                                                        Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid>
                                                        <TextBox Width="320"
                                                                 AutomationProperties.Name="{Binding Title}"
                                                                 Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Margin="13,0"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   IsHitTestVisible="False"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TextValue}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>

                                                <!-- Premium hotkey recorder -->
                                                <StackPanel Visibility="{Binding IsHotkey, Converter={StaticResource BoolToVisibility}}"
                                                            Width="320">
                                                    <!-- Recorder well: click to record -->
                                                    <Border Style="{StaticResource HotkeyRecorderWell}"
                                                            Cursor="Hand"
                                                            PreviewMouseLeftButtonDown="HotkeyWell_MouseLeftButtonDown">
                                                        <Grid>
                                                            <!-- Invisible TextBox for keyboard capture — needs real size to receive focus -->
                                                            <TextBox Opacity="0"
                                                                     IsReadOnly="True"
                                                                     Focusable="True"
                                                                     Cursor="Hand"
                                                                     Panel.ZIndex="-1"
                                                                     HorizontalAlignment="Stretch"
                                                                     VerticalAlignment="Stretch"
                                                                     GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                                                     LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" />

                                                            <!-- Idle state: keycap pills -->
                                                            <DockPanel LastChildFill="True">
                                                                <DockPanel.Style>
                                                                    <Style TargetType="DockPanel">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </DockPanel.Style>

                                                                <!-- Action buttons on the right -->
                                                                <StackPanel Orientation="Horizontal"
                                                                            DockPanel.Dock="Right"
                                                                            VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource HotkeyClearButton}"
                                                                            Click="HotkeyClear_Click" />
                                                                    <Button Style="{StaticResource HotkeyDefaultLink}"
                                                                            Click="HotkeyResetDefault_Click" />
                                                                </StackPanel>

                                                                <!-- Keycap pills -->
                                                                <ItemsControl Tag="{Binding Hotkey}"
                                                                              Loaded="HotkeyPills_Loaded"
                                                                              IsHitTestVisible="False"
                                                                              VerticalAlignment="Center">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </DockPanel>

                                                            <!-- Recording state overlay -->
                                                            <Border x:Name="RecordingBorder"
                                                                    Background="{StaticResource RecordingBackgroundBrush}"
                                                                    BorderBrush="{StaticResource RecordingPulseBrush}"
                                                                    BorderThickness="2"
                                                                    CornerRadius="6"
                                                                    Padding="10,4"
                                                                    Margin="-10,-8"
                                                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                                                                <StackPanel Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <Ellipse Width="8"
                                                                             Height="8"
                                                                             Fill="{StaticResource RecordingPulseBrush}"
                                                                             Margin="0,0,8,0"
                                                                             VerticalAlignment="Center" />
                                                                    <TextBlock Text="Recording... press a key combo or Esc to cancel"
                                                                               Foreground="{StaticResource RecordingTextBrush}"
                                                                               FontSize="13"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Conflict warning -->
                                                    <Border Style="{StaticResource HotkeyConflictWarning}"
                                                            Visibility="{Binding HasHotkeyConflict, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⚠"
                                                                       FontSize="13"
                                                                       Margin="0,0,6,0"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding HotkeyConflictMessage}"
                                                                       Foreground="{StaticResource HotkeyConflictBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="Medium"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Width="320"
                                                            HorizontalAlignment="Right"
                                                            Visibility="{Binding IsConfigTransfer, Converter={StaticResource BoolToVisibility}}">
                                                    <CheckBox Content="Include learned rules in export"
                                                              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              IsChecked="{Binding IncludeLearnedRules}"
                                                              AutomationProperties.Name="Include learned rules in export" />
                                                    <TextBlock Text="Optional: includes saved rejected text pairs."
                                                               TextWrapping="Wrap" Foreground="#667085" FontSize="12" Margin="0,4,0,12" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="Import…"
                                                                Command="{Binding DataContext.ImportConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Margin="0,0,8,0" />
                                                        <Button Content="Export…"
                                                                Command="{Binding DataContext.ExportConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding SelectedSection.ShowLanguageResults, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <controls:HighlightTextBlock HighlightText="{Binding SelectedSection.LanguageSearchCard.Title}" Query="{Binding SearchText}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding LanguageDetectionSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <controls:HighlightTextBlock HighlightText="{Binding SelectedSection.LanguageSearchCard.Description}" Query="{Binding SearchText}" TextWrapping="Wrap" Margin="0,6,0,12" />
                            <Button Content="Use automatic detection" Command="{Binding AutoDetectLanguageCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding SelectedSection.ShowApiKeyResults, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <controls:HighlightTextBlock HighlightText="{Binding SelectedSection.ApiKeySearchCard.Title}" Query="{Binding SearchText}" FontWeight="SemiBold" />
                            <controls:HighlightTextBlock HighlightText="{Binding SelectedSection.ApiKeySearchCard.Description}" Query="{Binding SearchText}" TextWrapping="Wrap" Margin="0,6,0,12" />
                            <Border Style="{StaticResource InputShell}" Margin="0,0,0,12">
                                <PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="API key" IsVisibleChanged="ApiKeyBox_IsVisibleChanged" BorderThickness="0" Background="Transparent" Padding="12" MinHeight="40" />
                            </Border>
                            <WrapPanel>
                                <Button Content="Save key securely" Click="SaveApiKey_Click" Margin="0,0,8,0" />
                                <Button Content="Remove saved key" Command="{Binding DeleteApiKeyCommand}" Margin="0,0,8,0" />
                                <Button Content="Refresh key status" Command="{Binding RefreshApiKeyCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ApiKeyMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TableShell}" Visibility="{Binding SelectedSection.ShowLogResults, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="16">
                            <controls:HighlightTextBlock HighlightText="{Binding SelectedSection.LogSearchCard.Title}" Query="{Binding SearchText}" FontWeight="SemiBold" />
                            <controls:HighlightTextBlock HighlightText="{Binding SelectedSection.LogSearchCard.Description}" Query="{Binding SearchText}" TextWrapping="Wrap" Margin="0,6,0,12" />
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="Refresh logs" Command="{Binding RefreshLogsCommand}" Margin="0,0,8,0" />
                                <Button Content="Clear logs" Command="{Binding ClearLogsCommand}" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding MetadataLogs}" AutomationProperties.Name="Correction metadata logs" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time (UTC)" Binding="{Binding OccurredAt}" Width="170" />
                                    <DataGridTextColumn Header="App" Binding="{Binding App}" Width="130" />
                                    <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="100" />
                                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="100" />
                                    <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="80" />
                                    <DataGridTextColumn Header="Replacement" Binding="{Binding ReplacementMethod}" Width="130" />
                                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="180" />
                                    <DataGridTextColumn Header="Latency (ms)" Binding="{Binding LatencyMs}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding LogsMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource TableShell}"
                            Margin="0,0,0,10"
                            Visibility="{Binding SelectedSection.ShowAppRulesResults, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel LastChildFill="True" Margin="16">
                            <controls:HighlightTextBlock DockPanel.Dock="Top" HighlightText="{Binding SelectedSection.AppRulesSearchCard.Title}" Query="{Binding SearchText}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <controls:HighlightTextBlock DockPanel.Dock="Top" HighlightText="{Binding SelectedSection.AppRulesSearchCard.Description}" Query="{Binding SearchText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="New app process (for example notepad.exe)" />
                                <Border Style="{StaticResource InputShell}" Margin="0,4,0,8"><TextBox Text="{Binding NewAppProcess, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New app process" /></Border>
                                <TextBlock Text="Window title pattern (optional)" />
                                <Border Style="{StaticResource InputShell}" Margin="0,4,0,0"><TextBox Text="{Binding NewAppWindowTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New app window title" /></Border>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Top"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,0,10">
                                <Button Content="Add"
                                        Command="{Binding AddAppRuleCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Delete"
                                        Command="{Binding DeleteAppRuleCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Reset defaults"
                                        Command="{Binding ResetAppRulesCommand}" />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding SelectedSection.AppRules}"
                                      SelectedItem="{Binding SelectedAppRule}"
                                      AutomationProperties.Name="App Rules"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      MaxHeight="350"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" IsReadOnly="True" Binding="{Binding ProcessName}" Width="170" />
                                    <DataGridTextColumn Header="Window title" IsReadOnly="True" Binding="{Binding WindowTitlePattern}" Width="170" />
                                    <DataGridComboBoxColumn Header="Mode"
                                                            SelectedValueBinding="{Binding ListBehavior, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="110">
                                        <DataGridComboBoxColumn.ItemsSource>
                                            <x:Array Type="{x:Type sys:String}">
                                                <sys:String>allowlist</sys:String>
                                                <sys:String>blocklist</sys:String>
                                            </x:Array>
                                        </DataGridComboBoxColumn.ItemsSource>
                                    </DataGridComboBoxColumn>
                                    <DataGridComboBoxColumn Header="Safety"
                                                            SelectedValueBinding="{Binding SafetyMode, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="110">
                                        <DataGridComboBoxColumn.ItemsSource>
                                            <x:Array Type="{x:Type sys:String}">
                                                <sys:String>auto</sys:String>
                                                <sys:String>terminal</sys:String>
                                                <sys:String>code_editor</sys:String>
                                            </x:Array>
                                        </DataGridComboBoxColumn.ItemsSource>
                                    </DataGridComboBoxColumn>
                                    <DataGridCheckBoxColumn Header="Editor prose" Binding="{Binding ProseContextAllowed, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                    <DataGridCheckBoxColumn Header="Local" Binding="{Binding LocalEngineAllowed, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <DataGridCheckBoxColumn Header="API" Binding="{Binding ApiEngineAllowed, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <DataGridCheckBoxColumn Header="Manual" Binding="{Binding ManualShortcutAllowed, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                    <DataGridCheckBoxColumn Header="Words" Binding="{Binding WordCountTriggerAllowed, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                    <DataGridCheckBoxColumn Header="Chars" Binding="{Binding CharacterTriggerAllowed, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource TableShell}"
                            Visibility="{Binding SelectedSection.ShowDictionaryResults, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="16">
                            <controls:HighlightTextBlock HighlightText="{Binding SelectedSection.DictionarySearchCard.Title}" Query="{Binding SearchText}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <controls:HighlightTextBlock HighlightText="{Binding SelectedSection.DictionarySearchCard.Description}" Query="{Binding SearchText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="New entry" Command="{Binding NewDictionaryCommand}" Margin="0,0,8,0" />
                                <Button Content="Refresh" Command="{Binding RefreshDictionaryCommand}" Margin="0,0,8,0" />
                                <Button Content="Delete selected" Command="{Binding DeleteDictionaryCommand}" />
                            </WrapPanel>
                        <DataGrid ItemsSource="{Binding SelectedSection.Dictionary}" SelectedItem="{Binding SelectedDictionary}"
                                  AutomationProperties.Name="Dictionary"
                                  IsReadOnly="True" MaxHeight="250"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Word / phrase" Binding="{Binding Word}" Width="*" />
                                <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="85" />
                                <DataGridTextColumn Header="App" Binding="{Binding AppLabel}" Width="110" />
                                <DataGridTextColumn Header="Rule" Binding="{Binding RuleLabel}" Width="110" />
                                <DataGridTextColumn Header="Blocked replacement" Binding="{Binding Replacement}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                            <ComboBox ItemsSource="{Binding DictionaryKinds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DictionaryKind}" Margin="0,12,0,8" AutomationProperties.Name="Exclusion type" />
                            <TextBlock Text="Original word or phrase" />
                            <Border Style="{StaticResource InputShell}" Margin="0,4,0,8"><TextBox Text="{Binding DictionaryWord, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dictionary word or phrase" /></Border>
                            <StackPanel Visibility="{Binding IsPairRule, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Never change it to (empty blocks deletion)" />
                                <Border Style="{StaticResource InputShell}" Margin="0,4,0,8"><TextBox Text="{Binding DictionaryReplacement, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Blocked replacement" /></Border>
                            </StackPanel>
                            <TextBlock Text="Language" />
                            <Border Style="{StaticResource InputShell}" Margin="0,4,0,8"><TextBox Text="{Binding DictionaryLanguage, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dictionary language" /></Border>
                            <TextBlock Text="App process (optional, for example notepad.exe)" />
                            <Border Style="{StaticResource InputShell}" Margin="0,4,0,12"><TextBox Text="{Binding DictionaryApp, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dictionary app scope" /></Border>
                            <Button Content="Save entry" Command="{Binding SaveDictionaryCommand}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding DictionaryMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Style="{StaticResource SettingsCard}" VerticalAlignment="Top"
                    Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="No matching settings" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Try a setting name, part of its description, or a behavior such as cancel oldest. Clear the search to browse all sections." TextWrapping="Wrap" Margin="0,8,0,12" />
                    <Button Content="Show all settings" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" Foreground="#667085" MaxHeight="60" />
            </StackPanel>
        </Grid>

        <Border Grid.ColumnSpan="2"
                Grid.RowSpan="2"
                Background="#CCF6F7FB"
                Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="620"
                    Padding="28"
                    Background="#FFFFFF"
                    BorderBrush="#DCE2EE"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DataContext="{Binding Onboarding}">
                <StackPanel>
                    <TextBlock Text="Set up AutoFix"
                               FontSize="26"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Choose the essentials. Advanced settings stay available after setup."
                               Margin="0,6,0,22"
                               Foreground="#667085"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Correction shortcut"
                               FontWeight="SemiBold" />
                    <Border Style="{StaticResource InputShell}" Margin="0,7,0,16">
                        <TextBox Text="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <TextBlock Text="Correction mode"
                               FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Modes}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Mode}"
                              Margin="0,7,0,16" />

                    <TextBlock Text="Engine"
                               FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Engines}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Engine}"
                              Margin="0,7,0,16" />

                    <StackPanel Visibility="{Binding NeedsApiKeyChoice, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="API key needed"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="No API key is configured for the selected API engine."
                                   Style="{StaticResource BodyText}"
                                   Margin="0,4,0,7" />
                        <ComboBox ItemsSource="{Binding ApiWithoutKeyChoices}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding ApiWithoutKeyChoice}"
                                  Margin="0,0,0,16" />
                    </StackPanel>

                    <CheckBox Content="Start with Windows"
                              IsChecked="{Binding StartWithWindows}"
                              FontWeight="SemiBold"
                              Margin="0,0,0,18" />

                    <Border Background="#F6F7FB"
                            BorderBrush="#DCE2EE"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,20">
                        <TextBlock Text="Advanced settings are available later: triggers, app rules, languages, privacy, and dictionary."
                                   TextWrapping="Wrap"
                                   Foreground="#5D6B82" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Finish setup"
                                Command="{Binding FinishCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Border x:Name="ImportPreviewPanel" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="#CCF6F7FB"
                KeyboardNavigation.TabNavigation="Cycle"
                Visibility="{Binding IsImportPreviewVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Margin="32" Padding="24" MaxWidth="980" MaxHeight="630" Background="White"
                    BorderBrush="#DCE2EE" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Preview import" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ImportPreview.SourceName}" FontWeight="SemiBold" Margin="0,6,0,6" />
                        <TextBlock Text="{Binding ImportPreview.Summary}" TextWrapping="Wrap" Foreground="#667085" />
                        <TextBlock Text="API keys, logs, session data and correction history are excluded. Existing secure keys stay on this device."
                                   TextWrapping="Wrap" Margin="0,8,0,16" />
                    </StackPanel>
                    <DataGrid x:Name="ImportChangesGrid" Grid.Row="1" ItemsSource="{Binding ImportPreview.Changes}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="False" EnableRowVirtualization="True"
                              AutomationProperties.Name="Import changes">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Section" Binding="{Binding Area}" Width="95" />
                            <DataGridTextColumn Header="Setting or rule" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Current" Binding="{Binding Before}" Width="*" />
                            <DataGridTextColumn Header="Imported" Binding="{Binding After}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="CancelImportButton" Content="Cancel" Command="{Binding CancelImportCommand}" Margin="0,0,8,0" />
                            <Button Content="Apply import" Command="{Binding ConfirmImportCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ImportPreview.ChangeSummary}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
