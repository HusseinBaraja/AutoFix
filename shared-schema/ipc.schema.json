{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autofix.local/schema/ipc.schema.json",
  "title": "AutoFix local IPC protocol",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "correctionMode": {
      "type": "string",
      "enum": ["typos_only", "typos_plus_grammar"]
    },
    "correctionEngine": {
      "type": "string",
      "enum": ["local", "api"]
    },
    "trayState": {
      "type": "string",
      "enum": ["idle", "active", "correcting", "blocked", "error"]
    },
    "appRule": {
      "type": "object",
      "required": ["process_name", "list_behavior", "manual_shortcut_allowed", "word_count_trigger_allowed", "character_trigger_allowed", "local_engine_allowed", "api_engine_allowed"],
      "properties": {
        "process_name": { "type": "string", "minLength": 1 },
        "window_title_pattern": { "type": ["string", "null"] },
        "list_behavior": { "enum": ["allowlist", "blocklist"] },
        "manual_shortcut_allowed": { "type": "boolean" },
        "word_count_trigger_allowed": { "type": "boolean" },
        "character_trigger_allowed": { "type": "boolean" },
        "local_engine_allowed": { "type": "boolean" },
        "api_engine_allowed": { "type": "boolean" },
        "safety_mode": { "enum": ["auto", "terminal", "code_editor"], "default": "auto" },
        "prose_context_allowed": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "deleteAppRule": {
      "type": "object",
      "required": ["process_name"],
      "properties": {
        "process_name": { "type": "string" },
        "window_title_pattern": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "appStatus": {
      "type": "object",
      "required": ["running", "correction_mode", "engine", "tray_state", "tray_state_enabled"],
      "properties": {
        "running": { "type": "boolean" },
        "correction_mode": { "$ref": "#/$defs/correctionMode" },
        "engine": { "$ref": "#/$defs/correctionEngine" },
        "tray_state": { "$ref": "#/$defs/trayState" },
        "tray_state_enabled": { "type": "boolean" }
      }
    },
    "request": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "get_app_status",
            "get_correction_mode",
            "get_current_engine",
            "reload_config",
            "update_setting",
            "list_app_rules",
            "upsert_app_rule",
            "delete_app_rule",
            "reset_app_rules",
            "open_logs",
            "request_undo_last_correction",
            "test_correction_engine_later",
            "is_background_running"
          ]
        },
        "payload": {
          "oneOf": [{ "$ref": "#/$defs/updateSettingRequest" }, { "$ref": "#/$defs/appRule" }, { "$ref": "#/$defs/deleteAppRule" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["update_setting", "upsert_app_rule", "delete_app_rule"] } } },
          "then": { "required": ["payload"] },
          "else": { "not": { "required": ["payload"] } }
        },
        {
          "if": { "properties": { "type": { "const": "upsert_app_rule" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/appRule" } } }
        },
        {
          "if": { "properties": { "type": { "const": "delete_app_rule" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/deleteAppRule" } } }
        },
        {
          "if": { "properties": { "type": { "const": "update_setting" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/updateSettingRequest" } } }
        }
      ]
    },
    "updateSettingRequest": {
      "type": "object",
      "required": ["path", "value"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z_]+(\\.[a-z_]+)+$"
        },
        "value": {}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["type", "payload"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "app_status",
            "correction_mode",
            "current_engine",
            "config_reloaded",
            "setting_updated",
            "app_rules",
            "app_rule_updated",
            "app_rule_deleted",
            "app_rules_reset",
            "logs",
            "undo_requested",
            "test_correction_engine_queued",
            "background_running",
            "shutdown_accepted",
            "error"
          ]
        },
        "payload": { "type": "object" }
      },
      "allOf": [{
        "if": { "properties": { "type": { "enum": ["app_status", "config_reloaded"] } } },
        "then": { "properties": { "payload": { "$ref": "#/$defs/appStatus" } } }
      }]
    }
  }
}
