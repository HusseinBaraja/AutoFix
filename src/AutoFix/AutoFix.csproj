<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>AutoFix</AssemblyName>
    <RootNamespace>AutoFix</RootNamespace>
    <ApplicationIcon>..\..\assets\brand\autofix-logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>AutoFix.Program</StartupObject>
    <Version>2.0.0</Version>
    <Product>AutoFix</Product>
    <Company>AutoFix</Company>
    <Description>AI autocorrect for every app on Windows</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is used only for the tray icon; avoid clashes with WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoFix.Core\AutoFix.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\brand\autofix-logo.ico" Link="Assets\autofix-logo.ico" />
    <Resource Include="..\..\assets\brand\autofix-logo-64.png" Link="Assets\autofix-logo-64.png" />
  </ItemGroup>

</Project>
